datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("USER") // ADMIN or USER
  coins     Int      @default(0)      // Loyalty reward coins
  createdAt DateTime @default(now())
  orders    Order[]
}

model Product {
  id           String  @id @default(uuid())
  name         String
  description  String
  price        Float
  salePrice    Float?
  image        String
  category     String
  goal         String
  flavors      String  // comma-separated list
  sizes        String  // comma-separated list
  stock        Int
  isBestSeller Boolean @default(false)
  isNewArrival Boolean @default(false)
  isHidden     Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id             String      @id @default(uuid())
  userId         String?     // Nullable for guest checkouts
  user           User?       @relation(fields: [userId], references: [id])
  customerName   String
  customerEmail  String
  customerPhone  String
  address        String
  city           String
  state          String
  pincode        String
  paymentMethod  String      // COD, UPI, CARD
  paymentStatus  String      @default("PENDING") // PENDING, PAID
  fulfillment    String      @default("PENDING") // PENDING, SHIPPED, DELIVERED
  subtotal       Float
  savings        Float
  total          Float
  promoCode      String?
  coinsRedeemed  Int         @default(0)
  coinsEarned    Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  flavor      String
  size        String
  quantity    Int
  price       Float
}
